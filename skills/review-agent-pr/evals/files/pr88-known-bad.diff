# FROZEN FIXTURE — known-bad state of mujtaba3B/mutwo PR #88 at commit 21a7ebc
# (before MuThree's fix 9d21892). Two blockers are present here:
#  1. require-issue.sh emits a TOP-LEVEL {"permissionDecision":"deny",...} with exit 0
#     instead of the nested {"hookSpecificOutput":{...}} shape -> never actually denies.
#  2. 'new file mode 100644' -> the hook is NOT executable -> cannot run.
# A correct review of this diff MUST catch both. Used by evals.json eval id 1.
# ---
diff --git a/.claude/hooks/require-issue.sh b/.claude/hooks/require-issue.sh
new file mode 100644
index 0000000..0c30f92
--- /dev/null
+++ b/.claude/hooks/require-issue.sh
@@ -0,0 +1,34 @@
+#!/bin/bash
+# Block file-modifying tool calls when no open GitHub issue exists for the current task.
+# Structural enforcement layer for the issue-first workflow (issue #18).
+# Behavioral layer: CLAUDE.md rule already active.
+
+# If gh is unavailable or unauthenticated, skip gracefully.
+if ! command -v gh &>/dev/null || ! gh auth status &>/dev/null 2>&1; then
+  echo '{}'
+  exit 0
+fi
+
+OPEN_COUNT=$(gh api 'repos/mujtaba3B/mutwo/issues?state=open&assignee=muthree-ai&per_page=1' \
+  --jq 'length' 2>/dev/null) || { echo '{}'; exit 0; }
+
+if [ "${OPEN_COUNT:-0}" -gt 0 ]; then
+  echo '{}'
+  exit 0
+fi
+
+cat >&2 <<'MSG'
+BLOCKED: No open GitHub issue found assigned to muthree-ai.
+
+Create a tracking issue before modifying files:
+  gh issue create --repo mujtaba3B/mutwo \
+    --title "your task title" \
+    --body "description" \
+    --assignee muthree-ai \
+    --label "<appropriate type label for this work>"
+
+This ensures all non-trivial work is tracked from the start (issue #18).
+MSG
+
+echo '{"permissionDecision":"deny","message":"No open issue assigned to muthree-ai. Create one first with: gh issue create --repo mujtaba3B/mutwo --assignee muthree-ai"}'
+exit 0
diff --git a/.claude/settings.json b/.claude/settings.json
index 2b42a8c..ae1b146 100644
--- a/.claude/settings.json
+++ b/.claude/settings.json
@@ -12,6 +12,24 @@
             "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/check-gstack.sh\""
           }
         ]
+      },
+      {
+        "matcher": "Edit",
+        "hooks": [
+          {
+            "type": "command",
+            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/require-issue.sh\""
+          }
+        ]
+      },
+      {
+        "matcher": "Write",
+        "hooks": [
+          {
+            "type": "command",
+            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/require-issue.sh\""
+          }
+        ]
       }
     ]
   }
