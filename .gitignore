.DS_Store

# Defense-in-depth: PM Penny user-scoped state lives at ~/.claude/pm-penny/
# (absolute). These globs ensure that any stray RELATIVE write into the in-repo
# pm/ plugin dir stays out of git. (The real defense is absolute paths in the
# skill code.)
/pm/*.json
/pm/fast-learnings.md

# Skill-creator description-optimization workspaces (per-skill, ephemeral).
# They can appear next to any skill under <plugin>/skills/, so match anywhere.
*-workspace/

# Karpathy three-file schema is local-only across every ~/dev/ repo (see
# ~/dev/CLAUDE.md tracking rule, 2026-05-30). README.md stays tracked.
/CLAUDE.md
/LOG.md
/INDEX.md

# Gate opt-in markers are machine-local (the gates ship in this repo's qa/eng
# plugins; a marker arms them for one repo). Recreate at bootstrap; never commit.
.qa-plan-gate.json
.ship-gate.json
.merge-clearance.json
