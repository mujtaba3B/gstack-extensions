#!/usr/bin/env bash
# Register this repo's persona plugins with Claude Code via a local marketplace.
#
# Each top-level dir with a .claude-plugin/plugin.json (pm/ qa/ eng/ design/) is
# a plugin; .claude-plugin/marketplace.json at the repo root lists all four. We
# add this repo as a "directory" marketplace and install each plugin from it, so
# its skills invoke namespaced as <plugin>:<skill> (/pm:bug, /qa:browser,
# /eng:pr-feedback, /design:pencil-mockup). The prefix is the plugin's manifest
# "name", not where the repo lives on disk.
#
# Why a marketplace and not symlinks into ~/.claude/skills/: a plugin dir
# symlinked into the skills dir is only ever discovered as "<name>@skills-dir",
# and it refuses to load when its name collides with a real installed plugin
# (we hit exactly that: pm@skills-dir vs pm@gstack-extensions). A marketplace
# install is the documented path, yields the clean /<name>: prefix, and never
# collides on the filesystem because plugins live in the plugin cache, not in
# ~/.claude/skills/. That also means gstack's loose /qa coexists with this
# repo's /qa:browser with zero special handling.
#
# install COPIES each plugin into
# ~/.claude/plugins/cache/<marketplace>/<name>/<version>/, so the repo is NOT
# read live. `claude plugin update` is a no-op while the version is unchanged,
# so to pick up edited skill bodies this script does uninstall+install (the only
# reliable way to refresh the cache from the working tree). Re-run after pulling
# updates (or use bin/gstack-extensions-upgrade), then restart the session.
#
# Idempotent: safe to re-run. Also purges stale symlinks left by the old
# (pre-marketplace) installer so they don't shadow the marketplace plugins.
set -euo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"
MARKET="gstack-extensions"
SKILLS_DIR="$HOME/.claude/skills"

# Read a plugin manifest's top-level "name" (the install ref and invocation
# prefix come from this, not the directory name). Parse as JSON so a nested
# "name" (e.g. under "author") can never be picked up by accident; fall back to
# a line-oriented sed only if python3 is somehow unavailable.
plugin_name() {
  if command -v python3 >/dev/null 2>&1; then
    python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["name"])' "$1" 2>/dev/null
  else
    sed -n 's/.*"name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$1" | head -1
  fi
}

if ! command -v claude >/dev/null 2>&1; then
  echo "error: the 'claude' CLI is not on PATH; cannot register plugins." >&2
  exit 1
fi

# Preflight: validate the marketplace + plugin manifests BEFORE mutating any
# installed state. Otherwise a broken manifest would uninstall a working cached
# plugin in the loop below and then fail to reinstall it, leaving it gone until
# the manifest is fixed. Non-strict on purpose: block on hard errors (the gate's
# job), not on lint warnings (run `claude plugin validate "$REPO" --strict` by
# hand for those).
echo "validating marketplace and plugin manifests..."
if ! claude plugin validate "$REPO" >/dev/null 2>&1; then
  echo "error: manifest validation failed; fix it before installing." >&2
  echo "  run: claude plugin validate \"$REPO\"" >&2
  exit 1
fi

# 1. Purge stale symlinks from the old symlink-based installer. A leftover
#    ~/.claude/skills/<name> -> $REPO/<plugin> loads as <name>@skills-dir and
#    collides with the marketplace plugin of the same name, so the symlinked
#    copy refuses to load. Remove any symlink under ~/.claude/skills/ whose
#    target points into this repo.
if [[ -d "$SKILLS_DIR" ]]; then
  for link in "$SKILLS_DIR"/*; do
    [[ -L "$link" ]] || continue
    target="$(readlink "$link" 2>/dev/null || true)"
    case "$target" in
      "$REPO"|"$REPO"/*)
        rm "$link"
        echo "removed stale symlink: $(basename "$link") -> $target"
        ;;
    esac
  done
fi

# 2. Register (or refresh) the local marketplace.
if claude plugin marketplace list 2>/dev/null | grep -q "$MARKET"; then
  echo "marketplace '$MARKET' already registered; refreshing from source..."
  claude plugin marketplace update "$MARKET" >/dev/null
else
  echo "adding marketplace '$MARKET' -> $REPO"
  claude plugin marketplace add "$REPO" --scope user >/dev/null
fi

# 3. Install every plugin the repo declares (any top-level dir with a
#    .claude-plugin/plugin.json). The install ref is <manifest-name>@<market>.
#    If a plugin is already installed, uninstall first so the cache is re-copied
#    from the current working tree (plain re-install and `update` both no-op
#    while the version string is unchanged).
shopt -s nullglob
fail=0
for manifest in "$REPO"/*/.claude-plugin/plugin.json; do
  name="$(plugin_name "$manifest")"
  [[ -n "$name" ]] || { echo "skip: $manifest has no \"name\"; not installing." >&2; fail=1; continue; }
  ref="${name}@${MARKET}"
  if claude plugin list 2>/dev/null | grep -q "$ref"; then
    claude plugin uninstall "$ref" >/dev/null 2>&1 || true
  fi
  if claude plugin install "$ref" --scope user >/dev/null; then
    echo "installed: $ref (invokes as /$name:<skill>)"
  else
    echo "ERROR: failed to install $ref" >&2
    fail=1
  fi
done
shopt -u nullglob

# 3b. Prune cached plugin versions whose QA-plan stamp writer PREDATES the
#     approval-token guard (gstack-extensions#71).
#
#     These are not merely stale, they are a live bypass. `claude plugin install`
#     copies into ~/.claude/plugins/cache/<market>/<plugin>/<version>/ and leaves
#     every older version dir behind, so a repo that has shipped N versions has N
#     copies of qa-plan-stamp.sh on disk, all executable by absolute path. The
#     ones written before #71 take `--approver` and require no token at all, so
#     they write a stamp bearing `git config user.name` for nobody's approval.
#
#     That is not hypothetical. On 2026-09-03 an agent blocked by the current
#     guarded writer found the cached 3.8.0 copy and ran it, and it produced
#     exactly that stamp on a real branch. The gate rejected it (it carries no
#     approval_source), so nothing merged, but the wrong tool was in reach and got
#     used within a day of the fix shipping.
#
#     Only versions OTHER than the one just installed are considered, and only
#     those whose writer fails qpt_writer_is_guarded, so this can never delete the
#     live copy and never touches a version that is already safe.
prune_unguarded_writers() {
  local cache="$HOME/.claude/plugins/cache/$MARKET/qa"
  local tlib="$REPO/qa/hooks/scripts/qa-plan-token-lib.sh"
  local keep pruned=0 d ver
  [[ -d "$cache" ]] || return 0
  [[ -f "$tlib" ]] || return 0
  # shellcheck source=/dev/null
  . "$tlib"
  keep="$(jq -r '.version // empty' "$REPO/qa/.claude-plugin/plugin.json" 2>/dev/null || true)"
  # No version means we cannot tell which dir is the live one, so prune nothing.
  [[ -n "$keep" ]] || return 0
  shopt -s nullglob
  for d in "$cache"/*; do
    [[ -d "$d" ]] || continue
    ver="$(basename "$d")"
    [[ "$ver" == "$keep" ]] && continue
    if [[ "$(qpt_writer_is_guarded "$d/hooks/scripts/qa-plan-stamp.sh")" == "no" ]]; then
      rm -rf "$d" && { echo "pruned unguarded stamp writer: qa/$ver"; pruned=$((pruned+1)); }
    fi
  done
  shopt -u nullglob
  [[ "$pruned" -gt 0 ]] && echo "  (those copies could write an approval stamp with no human approval)"
  return 0
}
prune_unguarded_writers

# 4. Stable-path shim for merge-clearance.sh. The real script ships inside the
#    eng plugin (eng/hooks/scripts/), but external callers invoke it by the
#    long-standing fixed path ~/.claude/scripts/merge-clearance.sh: the gstack
#    /land-and-deploy patch (eng/docs/land-and-deploy-merge-clearance.md) and
#    the pr-merge-gate block message both name it. The shim execs the newest
#    installed cache copy, so the path stays valid across version bumps.
mkdir -p "$HOME/.claude/scripts"
cat > "$HOME/.claude/scripts/merge-clearance.sh" <<'SHIM'
#!/usr/bin/env bash
# Shim installed by gstack-extensions bin/install. The real merge-clearance.sh
# ships inside the eng plugin; exec the newest installed cache copy.
set -euo pipefail
CACHE="$HOME/.claude/plugins/cache/gstack-extensions/eng"
# Highest installed version wins (sort -V), not newest mtime: deterministic
# when multiple cache version dirs coexist.
real=""
for d in $(ls -d "$CACHE"/*/ 2>/dev/null | sort -rV); do
  if [ -x "${d}hooks/scripts/merge-clearance.sh" ]; then
    real="${d}hooks/scripts/merge-clearance.sh"
    break
  fi
done
if [ -z "$real" ] || [ ! -x "$real" ]; then
  echo "merge-clearance shim: no installed eng plugin copy found under $CACHE; run gstack-extensions/bin/install" >&2
  exit 1
fi
exec "$real" "$@"
SHIM
chmod +x "$HOME/.claude/scripts/merge-clearance.sh"
echo "wrote shim: ~/.claude/scripts/merge-clearance.sh -> eng plugin cache"

# 5. Deploy the QA posture contract doc to its fixed path. The qa-status-gate
#    Stop hook's block message points agents at ~/.claude/docs/qa-status-postures.md
#    (a path baked into the ported script), so keep that path valid from this
#    repo now that claude-hooks no longer owns the doc.
mkdir -p "$HOME/.claude/docs"
cp "$REPO/qa/docs/qa-status-postures.md" "$HOME/.claude/docs/qa-status-postures.md"
echo "deployed: ~/.claude/docs/qa-status-postures.md (qa-status-gate contract)"

echo
# Exit non-zero if any plugin failed, so bin/gstack-extensions-upgrade's
# `if ! bin/install` guard catches it instead of reporting a clean upgrade.
if [[ "$fail" -ne 0 ]]; then
  echo "WARNING: one or more plugins failed to install (see errors above)." >&2
  echo "Re-run this script to retry; restart your session once it succeeds." >&2
  exit 1
fi
echo "Done. Restart your Claude Code session to load new/changed plugins."
echo "Verify with: claude plugin list"
echo "Skills invoke as /pm:<skill>, /qa:<skill>, /eng:<skill>, /design:<skill>, /marketing:<skill>."
